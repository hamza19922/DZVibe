{
  "expo": {
    "name": "DZVibe",
    "slug": "dzvibe",
    "version": "1.0.5",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "jsEngine": "hermes",
    "android": {
      "package": "com.dzvibe.app",
      "versionCode": 7,
      "jsEngine": "hermes",
      "navigationBarColor": "#050505",
      "navigationBarDividerColor": "#050505"
    },
    "ios": {
      "bundleIdentifier": "com.dzvibe.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      [
        "expo-video",
        {
          "supportsPictureInPicture": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "93b4205d-3151-42ce-99bc-aba98b346950"
      }
    }
  }
}
